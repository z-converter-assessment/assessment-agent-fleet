# Copy to terraform.tfvars and fill in values. terraform.tfvars 는 .gitignore 차단.
# 실제 staging 값 형상은 docs/adr/0004-topology.md 참조.

openstack_cloud = "openstack"
environment     = "staging"
keypair_name    = "agent-fleet"

network_name = "zconverter-private-net"
subnet_name  = "target-vms"

security_group_names = ["sg-agent"]

agent_workers = {
  "agent-debian12-vm-01" = {
    image  = "debian12_x64_uefi_3G"
    flavor = "c1_m1_r30"
    role   = "agent-host"
  }
}
