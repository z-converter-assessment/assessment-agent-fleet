[Unit]
Description=fleet noise generator ({{ noise_profile }})
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/stress-ng {{ noise_args }}
Restart=on-failure
RestartSec=30s
Nice=10
IOSchedulingClass=idle
# memory 보호 — noise 가 host 전체 메모리 점유하지 않게 cgroup 으로 제약
MemoryHigh={{ ansible_memtotal_mb // 2 }}M

StandardOutput=journal
StandardError=journal
SyslogIdentifier=noise-stress

[Install]
WantedBy=multi-user.target
