{# 공통 env (non-secret). docs/architecture/env-contract.md 의 단일 진실 반영. #}
{# secret 은 assessment-agent.env.local.j2 (vault) 로 분리. #}

# --- Broker connection ---
RABBITMQ_HOST={{ rabbitmq_host }}
RABBITMQ_PORT={{ rabbitmq_port | default(5672) }}
RABBITMQ_VHOST={{ rabbitmq_vhost | default('/') }}

# --- Broker tuning ---
RABBITMQ_HEARTBEAT_SEC={{ rabbitmq_heartbeat_sec | default(60) }}
RABBITMQ_CONFIRM_TIMEOUT_SEC={{ rabbitmq_confirm_timeout_sec | default(5) }}

# --- TLS ---
RABBITMQ_TLS_ENABLED={{ rabbitmq_tls_enabled | default(0) }}
{% if (rabbitmq_tls_enabled | default(0) | int) == 1 %}
RABBITMQ_TLS_CA_PATH={{ rabbitmq_tls_ca_path | default('/etc/assessment-agent/ca.pem') }}
RABBITMQ_TLS_VERIFY_PEER={{ rabbitmq_tls_verify_peer | default(1) }}
RABBITMQ_TLS_VERIFY_HOSTNAME={{ rabbitmq_tls_verify_hostname | default(1) }}
{% if rabbitmq_tls_cert_path | default('') | length > 0 %}
RABBITMQ_TLS_CERT_PATH={{ rabbitmq_tls_cert_path }}
{% endif %}
{% endif %}

# --- Routing contract ---
RABBITMQ_EXCHANGE={{ rabbitmq_exchange | default('assessment') }}
RABBITMQ_ROUTING_KEY_INVENTORY={{ rabbitmq_routing_key_inventory | default('server.inventory') }}
RABBITMQ_ROUTING_KEY_METRICS={{ rabbitmq_routing_key_metrics | default('server.metrics') }}
RABBITMQ_ROUTING_KEY_ERROR={{ rabbitmq_routing_key_error | default('server.error') }}

# --- Agent runtime ---
AGENT_INTERVAL_SEC={{ agent_interval_sec | default(60) }}
{% if agent_external_ip | default('') | length > 0 %}
AGENT_EXTERNAL_IP={{ agent_external_ip }}
{% endif %}

# --- Worker (task.install) — vault_rabbitmq_worker_user 가 채워지면 worker 활성화 ---
{% if agent_worker_allowed_hosts | default('') | length > 0 %}
WORKER_DOWNLOAD_ALLOWED_HOSTS={{ agent_worker_allowed_hosts }}
{% endif %}
