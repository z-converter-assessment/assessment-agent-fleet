{# docs/architecture/env-contract.md 의 키 카탈로그를 그대로 반영. 결정 후 채움. #}
AGENT_ID={{ inventory_hostname }}
AGENT_LOG_LEVEL={{ agent_log_level | default('info') }}
AGENT_INTERVAL_SEC={{ agent_interval_sec | default(60) }}

{% if engine_endpoint | default('') | length > 0 %}
ENGINE_ENDPOINT={{ engine_endpoint }}
{% endif %}

{% if vault_engine_api_token | default('') | length > 0 %}
ENGINE_API_TOKEN={{ vault_engine_api_token }}
{% endif %}
