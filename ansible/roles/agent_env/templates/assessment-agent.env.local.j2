{# secret env (vault). docs/architecture/env-contract.md 의 secret 카탈로그 반영. #}
{# 평문 commit 금지. ansible-vault 로 암호화된 vault.yml 에서만 변수 주입. #}

# --- Broker credentials ---
RABBITMQ_USER={{ vault_rabbitmq_user }}
RABBITMQ_PASS={{ vault_rabbitmq_pass }}

{% if (rabbitmq_tls_enabled | default(0) | int) == 1 and (vault_rabbitmq_tls_key | default('')) | length > 0 %}
# --- mTLS client key (선택) ---
RABBITMQ_TLS_KEY_PATH={{ rabbitmq_tls_key_path | default('/etc/assessment-agent/client.key') }}
{% endif %}
