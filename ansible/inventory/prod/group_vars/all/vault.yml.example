# Copy and encrypt:
#   ansible-vault encrypt --output vault.yml vault.yml.example
# 또는 처음부터 암호화 생성:
#   ansible-vault create vault.yml
#
# 명명: vault_<키> 접두. assessment-agent.env.j2 가 {{ vault_xxx }} 로 참조.
# 평문 commit 금지: vault.yml 은 ansible-vault 로 암호화된 상태로만 commit.

vault_engine_api_token: "REPLACE_ME"
